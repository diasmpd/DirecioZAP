# ──────────────────────────────────────────────────────────────
# DirecioZAP — Exemplo de configuracao
# Copie para .env e preencha com suas credenciais
# NUNCA commite o arquivo .env
# ──────────────────────────────────────────────────────────────

# Provedor WhatsApp: Twilio | Meta
WHATSAPP_PROVIDER=Twilio

# ── Twilio ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886

# ── Meta WhatsApp Cloud API ───────────────────────────────────
META_PHONE_NUMBER_ID=000000000000000
META_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_VERIFY_TOKEN=troque_por_token_seguro_aleatorio
# App Settings > Basic > App Secret (obrigatorio: valida a assinatura dos webhooks)
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Versao da Graph API (conferir a atual em developers.facebook.com/docs/graph-api/changelog)
META_API_VERSION=v23.0

# ── Token de seguranca para /exportar ────────────────────────
VERIFY_TOKEN=troque_por_token_seguro_aleatorio

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sua_supabase_anon_key_aqui

# ── ngrok ─────────────────────────────────────────────────────
NGROK_AUTH_TOKEN=seu_ngrok_auth_token_aqui
NGROK_DOMAIN=

# ── Saida Excel ───────────────────────────────────────────────
EXCEL_PATH=./data/fornecedores.xlsx
